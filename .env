# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=HomeFinance

# Backend (dotnet environment variables) - 👇 ATENÇÃO: Host=postgres (não localhost!)
ConnectionStrings__Connection=Host=postgres;Port=5432;Database=HomeFinance;Username=postgres;Password=postgres
#ConnectionStrings__Connection=Host=localhost;Port=5432;Database=HomeFinance;Username=postgres;Password=postgres

Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:5173
Cors__AllowedOrigins__2=http://192.168.3.27:3000

# Frontend (build-time for Docker; runtime for local Vite)
VITE_API_URL=http://192.168.3.27:5000
#VITE_API_URL=http://localhost:5000

# JWT (reserved for future auth)
# JWT__Secret=change-me
# JWT__Issuer=HomeFinance
# JWT__Audience=HomeFinance